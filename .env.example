# Port the call is served on.
PORT=8080

# Herdr config directory holding herdr.sock (Docker only).
HERDR_DIR=~/.config/herdr

# Text-to-speech: kokoro or none (captions only).
TTS=kokoro
VOICES=pm_alex,pf_dora,pm_santa
SPEECH_SPEED=1.1

# Summarizer: command or none. Any shell command that reads the prompt on
# stdin and prints the summary works. Shell aliases are not loaded, so call
# the real binary or wrap it, e.g. zsh -ic 'my-alias -p --model haiku'.
SUMMARIZER=
SUMMARY_COMMAND=

POLL_INTERVAL=3s

# Claude Code config directories whose session transcripts are read (colon-separated globs),
# or none to read agents only from their screen. Defaults to ~/.claude*.
CLAUDE_TRANSCRIPT_DIRS=

# Where chat images are saved; agents receive these paths.
UPLOAD_DIR=/tmp/agent-meet

# Optional: host CLI mounted into the app container for SUMMARY_COMMAND.
CLAUDE_BIN=
CLAUDE_CONFIG_DIR=
